# Скопируйте файл в .env и подставьте свои значения. Файл .env не попадает в репозиторий.

# Адрес OpenAI-совместимого API (один и тот же для генерации, эмбеддингов и реранка).
# Пример для OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Ключ доступа к API. Не публикуйте действующий ключ.
LLM_API_KEY=

# Модели. По регламенту кейса: генерация — DeepSeek V4.1 Flash, эмбеддинги — BAAI/bge-m3,
# реранкер — Qwen3 Reranker 8B (необязателен: без него поиск остаётся гибридным).
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Порт веб-интерфейса на хосте.
APP_PORT=8000

# Необязательные переключатели ядра (значения по умолчанию показаны).
# LA_USE_EMBEDDINGS=1      векторный поиск bge-m3
# LA_USE_RERANKER=1        реранкер
# LA_SECOND_PASS=1         расширенный поиск перед отказом
# LA_REPAIR=1              исправление ответа после проверки кодом
